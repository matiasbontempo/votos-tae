# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project Settings -> API. La anon key es publica por diseno: solo puede LEER
# el estado de la funcion y los conteos (ver politicas RLS en supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key. NUNCA con prefijo NEXT_PUBLIC_. Solo se usa en el servidor
# (rutas /api y server actions) para insertar votos y administrar funciones.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# Password del panel /admin.
ADMIN_PASSWORD=cambiame

# Secreto para firmar la cookie de sesion del admin.
# Generar con: openssl rand -hex 32
AUTH_SECRET=cambiame-por-un-hex-de-64-caracteres

# ---------------------------------------------------------------------------
# Opcional
# ---------------------------------------------------------------------------
# Dominio que se codifica en el QR de las butacas. Solo hace falta si el QR se
# genera desde un dominio distinto al que va a usar el publico. Si no se define,
# se usa el dominio con el que estas navegando el panel, que suele ser correcto.
NEXT_PUBLIC_SITE_URL=

# Variante de UI por defecto para la pantalla de votacion: stack | swipe | grid
# Vacio = stack (scroll vertical), que es la que mejor aguanta siete sospechosos.
NEXT_PUBLIC_DEFAULT_VOTE_UI=stack

# Tope de votos por IP por funcion. El teatro entero puede compartir una sola IP
# si usan el wifi de la sala, asi que un valor bajo bloquea gente legitima.
# Vacio o 0 = sin limite (default). Con datos moviles cada celular tiene su IP.
VOTE_IP_LIMIT=
